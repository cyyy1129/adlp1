# Supabase Configuration (required for auth & database)
VITE_SUPABASE_URL=your-supabase-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional API keys (app starts without these)
# VITE_OPENAI_API_KEY=
# VITE_WEATHER_API_KEY=
# The current map uses Leaflet + OpenStreetMap and needs no key.
# Reserved only if a future Google Maps implementation is added:
# VITE_GOOGLE_MAPS_API_KEY=
